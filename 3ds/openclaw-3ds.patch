+// Read-only streambuf that serves reads out of a large in-memory window instead of hitting
+// the underlying file for every tiny seek/read. Parsing the REZ directory tree does tens of
+// thousands of 1-4 byte reads; on platforms with slow small-read file access (3DS SD card)
+// that takes minutes, while block reads make it nearly instant. Positions are absolute file
+// offsets, so it is a drop-in replacement for the file stream while reading directory entries.
+class RezBlockBuf : public std::streambuf
+{
+public:
+    RezBlockBuf(std::istream* source, std::streamoff fileSize)
+        : m_source(source), m_fileSize(fileSize), m_winStart(0), m_winLen(0), m_pendingPos(0), m_window(kBlockSize)
+    {
+        setg(0, 0, 0);
+    }
+
+protected:
+    std::streamoff AbsPos() const
+    {
+        return (eback() == 0) ? m_pendingPos : (m_winStart + (gptr() - eback()));
+    }
+
+    pos_type seekoff(off_type off, std::ios_base::seekdir dir, std::ios_base::openmode) override
+    {
+        std::streamoff target;
+        if (dir == std::ios_base::beg) target = off;
+        else if (dir == std::ios_base::cur) target = AbsPos() + off;
+        else target = m_fileSize + off;
+
+        if (target < 0 || target > m_fileSize)
+        {
+            return pos_type(off_type(-1));
+        }
+
+        if (m_winLen > 0 && target >= m_winStart && target <= m_winStart + (std::streamoff)m_winLen)
+        {
+            setg(m_window.data(), m_window.data() + (target - m_winStart), m_window.data() + m_winLen);
+        }
+        else
+        {
+            setg(0, 0, 0);
+            m_pendingPos = target;
+        }
+        return pos_type(target);
+    }
+
+    pos_type seekpos(pos_type pos, std::ios_base::openmode which) override
+    {
+        return seekoff(off_type(pos), std::ios_base::beg, which);
+    }
+
+    int_type underflow() override
+    {
+        std::streamoff pos = AbsPos();
+        if (pos >= m_fileSize)
+        {
+            return traits_type::eof();
+        }
+
+        m_source->clear();
+        m_source->seekg(pos, std::ios::beg);
+        m_source->read(m_window.data(), (std::streamsize)m_window.size());
+        std::streamsize got = m_source->gcount();
+        m_source->clear();
+        if (got <= 0)
+        {
+            return traits_type::eof();
+        }
+
+        m_winStart = pos;
+        m_winLen = (size_t)got;
+        setg(m_window.data(), m_window.data(), m_window.data() + m_winLen);
+        return traits_type::to_int_type(*gptr());
+    }
+
+private:
+    static const size_t kBlockSize = 64 * 1024;
+
+    std::istream* m_source;
+    std::streamoff m_fileSize;
+    std::streamoff m_winStart;
+    size_t m_winLen;
+    std::streamoff m_pendingPos;
+    std::vector<char> m_window;
+};
+
