diff --git a/OpenClaw/Engine/Graphics2D/Image.cpp b/OpenClaw/Engine/Graphics2D/Image.cpp
index b6a6159..56a542b 100644
--- a/OpenClaw/Engine/Graphics2D/Image.cpp
+++ b/OpenClaw/Engine/Graphics2D/Image.cpp
@@ -76,6 +76,71 @@ static void PutPixel(SDL_Surface *surface, int x, int y, Uint32 pixel)
     }
 }
 
+static bool g_DownscaleEnabled = true;
+
+void Image::SetDownscaleEnabled(bool enabled)
+{
+    g_DownscaleEnabled = enabled;
+}
+
+#ifdef __3DS__
+// Half-size copy of a 32-bit RGBA surface (byte order R,G,B,A) using an alpha-weighted 2x2 box filter,
+// so transparent texels do not darken the edges of sprites.
+static SDL_Surface* DownscaleHalf(SDL_Surface* src)
+{
+    int dw = (src->w + 1) / 2;
+    int dh = (src->h + 1) / 2;
+    SDL_Surface* dst = Util::CreateRGBSurface(0, dw, dh, 32);
+    if (dst == NULL)
+    {
+        return NULL;
+    }
+
+    for (int y = 0; y < dh; y++)
+    {
+        const int y0 = y * 2;
+        const int y1 = (y0 + 1 < src->h) ? y0 + 1 : y0;
+        Uint8* out = (Uint8*)dst->pixels + y * dst->pitch;
+        for (int x = 0; x < dw; x++)
+        {
+            const int x0 = x * 2;
+            const int x1 = (x0 + 1 < src->w) ? x0 + 1 : x0;
+            const Uint8* p[4] =
+            {
+                (const Uint8*)src->pixels + y0 * src->pitch + x0 * 4,
+                (const Uint8*)src->pixels + y0 * src->pitch + x1 * 4,
+                (const Uint8*)src->pixels + y1 * src->pitch + x0 * 4,
+                (const Uint8*)src->pixels + y1 * src->pitch + x1 * 4
+            };
+
+            unsigned r = 0, g = 0, b = 0, a = 0;
+            for (int i = 0; i < 4; i++)
+            {
+                unsigned pa = p[i][3];
+                r += p[i][0] * pa;
+                g += p[i][1] * pa;
+                b += p[i][2] * pa;
+                a += pa;
+            }
+
+            if (a == 0)
+            {
+                out[0] = out[1] = out[2] = out[3] = 0;
+            }
+            else
+            {
+                out[0] = (Uint8)((r + a / 2) / a);
+                out[1] = (Uint8)((g + a / 2) / a);
+                out[2] = (Uint8)((b + a / 2) / a);
+                out[3] = (Uint8)((a + 2) / 4);
+            }
+            out += 4;
+        }
+    }
+    return dst;
+}
+#endif
+
 SDL_Texture* Image::GetTextureFromPid(WapPid* pid, SDL_Renderer* renderer)
 {
     assert(pid != NULL);
@@ -98,9 +163,52 @@ SDL_Texture* Image::GetTextureFromPid(WapPid* pid, SDL_Renderer* renderer)
         PutPixel(surface, x, y, SDL_MapRGBA(surface->format, color.r, color.g, color.b, color.a));
     }
 
+#ifdef __3DS__
+    if (g_DownscaleEnabled)
+    {
+        float scaleX = 1.0f, scaleY = 1.0f;
+        SDL_RenderGetScale(renderer, &scaleX, &scaleY);
+        if (scaleX == 0.5f && scaleY == 0.5f)
+        {
+            // The renderer shrinks everything to 50% anyway. Doing it once here makes the per-frame
+            // copy an unscaled blit (much faster in SDL's software renderer) and cuts texture memory to 1/4.
+            // The Image keeps reporting the original width/height, so all layout code is unchanged.
+            if (SDL_Surface* half = DownscaleHalf(surface))
+            {
+                SDL_FreeSurface(surface);
+                surface = half;
+            }
+        }
+    }
+#endif
+
+#ifdef __3DS__
+    // Fully opaque images (tiles, backgrounds) do not need alpha blending: a plain copy is ~10x faster
+    bool isOpaque = true;
+    for (int y = 0; y < surface->h && isOpaque; y++)
+    {
+        const Uint8* row = (const Uint8*)surface->pixels + y * surface->pitch;
+        for (int x = 0; x < surface->w; x++)
+        {
+            if (row[x * 4 + 3] != 255)
+            {
+                isOpaque = false;
+                break;
+            }
+        }
+    }
+#endif
+
     SDL_Texture* texture = SDL_CreateTextureFromSurface(renderer, surface);
     assert(texture != NULL);
 
+#ifdef __3DS__
+    if (isOpaque && texture != NULL)
+    {
+        SDL_SetTextureBlendMode(texture, SDL_BLENDMODE_NONE);
+    }
+#endif
+
     SDL_FreeSurface(surface);
 
     return texture;
