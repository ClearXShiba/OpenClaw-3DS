     }
 }
 
+static bool g_DownscaleEnabled = true;
+
+void Image::SetDownscaleEnabled(bool enabled)
+{
+    g_DownscaleEnabled = enabled;
+}
+
+#ifdef __3DS__
+// Half-size copy of a 32-bit RGBA surface (byte order R,G,B,A) using an alpha-weighted 2x2 box filter,
+// so transparent texels do not darken the edges of sprites.
+static SDL_Surface* DownscaleHalf(SDL_Surface* src)
+{
+    int dw = (src->w + 1) / 2;
+    int dh = (src->h + 1) / 2;
+    SDL_Surface* dst = Util::CreateRGBSurface(0, dw, dh, 32);
+    if (dst == NULL)
+    {
+        return NULL;
+    }
+
+    for (int y = 0; y < dh; y++)
+    {
+        const int y0 = y * 2;
+        const int y1 = (y0 + 1 < src->h) ? y0 + 1 : y0;
+        Uint8* out = (Uint8*)dst->pixels + y * dst->pitch;
+        for (int x = 0; x < dw; x++)
+        {
+            const int x0 = x * 2;
+            const int x1 = (x0 + 1 < src->w) ? x0 + 1 : x0;
+            const Uint8* p[4] =
+            {
+                (const Uint8*)src->pixels + y0 * src->pitch + x0 * 4,
+                (const Uint8*)src->pixels + y0 * src->pitch + x1 * 4,
+                (const Uint8*)src->pixels + y1 * src->pitch + x0 * 4,
+                (const Uint8*)src->pixels + y1 * src->pitch + x1 * 4
+            };
+
+            unsigned r = 0, g = 0, b = 0, a = 0;
+            for (int i = 0; i < 4; i++)
+            {
+                unsigned pa = p[i][3];
+                r += p[i][0] * pa;
+                g += p[i][1] * pa;
+                b += p[i][2] * pa;
+                a += pa;
+            }
+
+            if (a == 0)
+            {
+                out[0] = out[1] = out[2] = out[3] = 0;
+            }
+            else
+            {
+                out[0] = (Uint8)((r + a / 2) / a);
+                out[1] = (Uint8)((g + a / 2) / a);
+                out[2] = (Uint8)((b + a / 2) / a);
+                out[3] = (Uint8)((a + 2) / 4);
+            }
+            out += 4;
+        }
+    }
+    return dst;
+}
+
+// Renderers with a texture size limit (the PSP GPU: 512x512) cannot hold full-size menu/loading screens.
+// Shrink such a surface by 2 until it fits; the Image keeps reporting the original size (see CreatePcxImage),
+// so the layout code is unchanged and the GPU simply stretches the texture. Renderers without a limit
+// (the 3DS software renderer reports 0) are not affected.
+static SDL_Surface* FitToRenderer(SDL_Surface* s, SDL_Renderer* r)
+{
+    SDL_RendererInfo info;
+    if (SDL_GetRendererInfo(r, &info) != 0 || info.max_texture_width <= 0 || info.max_texture_height <= 0)
+    {
+        return s;
+    }
+    while (s->w > info.max_texture_width || s->h > info.max_texture_height)
+    {
+        SDL_Surface* rgba = SDL_ConvertSurfaceFormat(s, (SDL_BYTEORDER == SDL_BIG_ENDIAN) ? SDL_PIXELFORMAT_RGBA8888 : SDL_PIXELFORMAT_ABGR8888, 0) /* bytes R,G,B,A in memory */;
+        if (rgba == NULL)
+        {
+            return s;
+        }
+        SDL_Surface* half = DownscaleHalf(rgba);
+        SDL_FreeSurface(rgba);
+        if (half == NULL)
+        {
+            return s;
+        }
+        SDL_FreeSurface(s);
+        s = half;
+    }
+    return s;
+}
+#endif
